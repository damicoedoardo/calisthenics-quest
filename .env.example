# FORMA server settings: copy to .env on the server (never commit .env). See
# scripts/deploy/README.md.

# The api's public address; point its DNS A record at the server.
DOMAIN=api.example.com

# A long random password: openssl rand -hex 24
POSTGRES_PASSWORD=

# From the Supabase project (Settings, API): <project-ref> is the part before .supabase.co
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Web app origins allowed to call the api (Vercel previews are allowed in code).
CORS_ORIGINS=https://forma-nu-red.vercel.app,http://localhost:3000

# Party voice (LiveKit). The address phones join; point its DNS A record at the server too.
VOICE_DOMAIN=voice.example.com
LIVEKIT_URL=wss://voice.example.com
# A key name and a long random secret (openssl rand -hex 32); LiveKit and the api share them.
LIVEKIT_API_KEY=forma
LIVEKIT_API_SECRET=

# The coach: OpenRouter through the LiteLLM proxy (litellm-config.yaml).
# The OpenRouter key from openrouter.ai/keys, and a long random master key (openssl rand -hex 32)
# that the api uses to talk to the proxy. Empty: the coach is off.
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=

# Live party runs: the game server (the `play` service). The address phones open, on the api's own
# domain, and a long random secret (openssl rand -hex 32) the api and the game server share.
# Empty: no live runs, a party plays with bots.
PLAY_URL=wss://api.example.com/play
PLAY_SECRET=
