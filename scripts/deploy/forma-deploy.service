[Unit]
Description=FORMA backend auto-deploy (poll GHCR, zero-downtime rollout)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# flock: never two runs at once; -n fails fast instead of queueing.
ExecStart=/usr/bin/flock -n /run/forma-deploy.lock /root/forma/scripts/deploy/poll-deploy.sh
# A rollout waits for the new container to be healthy; give it room.
TimeoutStartSec=600
