# The api's public address (DOMAIN in .env). Caddy fetches and renews the certificate itself.
{$DOMAIN:localhost} {
    # Live party runs: the game server's WebSocket (play/server.ts).
    handle /play* {
        reverse_proxy play:8090
    }

    # Everything else is the api. Find the `api` container again every 2s, and retry a request that
    # lands on one being removed, so a `docker rollout api` swaps versions without dropping
    # requests. Same as minlit.
    handle {
        reverse_proxy {
            dynamic a {
                name api
                port 8000
                refresh 2s
            }
            lb_try_duration 10s
            lb_try_interval 250ms
            transport http {
                dial_timeout 2s
            }
        }
    }
}

# Party voice: phones join LiveKit here (a WebSocket); the talk itself goes on UDP 7882.
{$VOICE_DOMAIN:voice.localhost} {
    reverse_proxy livekit:7880
}
