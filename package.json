{
  "name": "forma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "sim": "SIM_OUT=sim-out vitest run src/sim",
    "balance": "vitest run src/balance -u",
    "fog:balance": "node scripts/fog-balance.cjs",
    "fog:sim": "node --no-warnings scripts/fog-sim.mjs",
    "fog:sheet": "SHEET=1 node --no-warnings scripts/fog-sim.mjs steady 48",
    "fog:tune": "node --no-warnings scripts/fog-sim.mjs tune",
    "exercises:db": "node --no-warnings scripts/export-exercises.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "handbook:lint": "node scripts/handbook.mjs lint",
    "handbook:check": "node scripts/handbook.mjs check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "livekit-client": "2.22.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "phaser": "3.90.0",
    "posthog-js": "^1.441.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "8.18.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "ws": "8.18.3"
  }
}
